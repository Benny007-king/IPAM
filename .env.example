# Settings for development (npm run dev). Everything is optional.
# The installed Windows service gets its settings from the installer; to add one
# there, run "C:\Program Files\IPAM\nssm.exe" edit IPAM (Environment tab).

# Port the server listens on (default 3000).
PORT=3000

# Folder for IPAM's data: the built-in SQLite database, the connection settings
# saved from Settings > Database (database.json), the session secret and upgrades.
# Default: C:\ProgramData\IPAM when installed, the working directory in development.
# DATA_DIR=C:\ProgramData\IPAM

# Only the SQLite file, if it should live somewhere else:
# DB_PATH=D:\IPAM\ipam.db

# Session-signing secret. Leave unset: a random one is created on first start
# and kept in DATA_DIR/.jwt-secret. Set it only to share sessions between servers.
# JWT_SECRET=

# Set to "true" ONLY when IPAM is served over HTTPS (the cookie then becomes
# Secure + SameSite=None). Leave it off for plain HTTP or sign-in will not work.
COOKIE_SECURE=false

# --- External database (optional) -------------------------------------------
# Normally chosen in Settings > Database. Setting it here pins it and the UI
# shows it read-only. Use either a URL...
# DATABASE_URL=postgres://ipam:secret@db.example.local:5432/ipam?sslmode=require
# DATABASE_URL=mysql://ipam:secret@db.example.local:3306/ipam
# DATABASE_URL=mssql://ipam:secret@sql01.example.local:1433/ipam
# ...or the separate fields:
# DB_CLIENT=postgres          # sqlite | postgres | mysql (also MariaDB) | mssql
# DB_HOST=db.example.local    # SQL Server named instance: sql01\SQLEXPRESS
# DB_PORT=5432
# DB_NAME=ipam
# DB_USER=ipam
# DB_PASSWORD=secret
# DB_TLS=off                  # off | verify (trusted certificate) | trust (any certificate)
