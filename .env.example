# Copy this file to .env and adjust the values for your deployment.

# Secret used to sign session JWTs. Set this to a long random string in
# production — anyone who knows it can forge login tokens.
JWT_SECRET="change-me-to-a-long-random-secret"

# Port the Node server listens on (defaults to 3000).
PORT=3000

# Set to "true" ONLY when the app is served over HTTPS. When true, the auth
# cookie is flagged Secure + SameSite=None. Leave false/unset for plain HTTP
# deployments (e.g. behind an IIS reverse proxy) or login will not work.
COOKIE_SECURE=false
